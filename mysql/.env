# MySQL 环境变量
MYSQL_ROOT_PASSWORD=root@XH2001!
MYSQL_DATABASE=db_single_admin

# 字符集与时区
MYSQL_CHARACTER_SET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_DEFAULT_TIME_ZONE=+8:00

# 连接
MYSQL_MAX_CONNECTIONS=500
MYSQL_WAIT_TIMEOUT=28800

# InnoDB
MYSQL_INNODB_BUFFER_POOL_SIZE=1G
MYSQL_INNODB_LOG_FILE_SIZE=512M

# 安全
MYSQL_SQL_MODE=STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
