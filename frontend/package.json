{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-view-registry.mjs && vite",
    "dev:test": "node scripts/generate-view-registry.mjs && vite --mode test",
    "dev:prod": "node scripts/generate-view-registry.mjs && vite --mode production",
    "build": "node scripts/generate-view-registry.mjs && vite build",
    "build:test": "node scripts/generate-view-registry.mjs && vite build --mode test",
    "build:prod": "node scripts/generate-view-registry.mjs && vite build --mode production",
    "preview": "vite preview",
    "views:sync": "node scripts/generate-view-registry.mjs",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:ci": "run-s lint:ci:oxlint lint:ci:eslint",
    "lint:ci:oxlint": "oxlint . --deny-warnings",
    "lint:ci:eslint": "eslint . --max-warnings=0",
    "format": "prettier --write --experimental-cli src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@imengyu/vue3-context-menu": "^1.5.4",
    "axios": "^1.13.6",
    "echarts": "^6.1.0",
    "element-china-area-data": "^6.1.0",
    "element-plus": "^2.13.5",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "object-path": "^0.11.8",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-vue": "^0.5.10",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "screenfull": "^6.0.2",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitejs/plugin-vue-jsx": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.50.0",
    "eslint-plugin-vue": "~10.8.0",
    "fast-glob": "^3.3.3",
    "globals": "^17.3.0",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.50.0",
    "postcss": "^8.5.32",
    "prettier": "3.8.1",
    "tailwindcss": "^3.4.10",
    "terser": "^5.46.1",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.1",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
