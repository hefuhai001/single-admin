# 后端本地开发环境变量模板
# 使用方式：复制为 backend/.env（该文件已被 .gitignore 忽略），按需填写
# 注意：基础配置不再默认激活 dev，本地启动需显式指定 --spring.profiles.active=dev
#       或在启动命令中使用 -Dspring-boot.run.profiles=dev
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=db_single_admin
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=CHANGE_ME
