# 后端本地开发环境变量模板
# 使用方式：复制为 backend/.env（该文件已被 .gitignore 忽略），按需填写
# 注意：基础配置不再默认激活 dev，本地启动需显式指定 profile：
#       PowerShell：$env:SPRING_PROFILES_ACTIVE='dev'; mvn spring-boot:run
#       bash：      SPRING_PROFILES_ACTIVE=dev ./mvnw spring-boot:run
#       或把 -D 参数整体加引号：mvn spring-boot:run "-Dspring-boot.run.profiles=dev"
#       （PowerShell 5.1 不加引号会拆分 -D 参数，导致 Unknown lifecycle phase）
# 后端基于 Java 25 编译，JAVA_HOME 需指向 JDK 25
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=db_single_admin
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=CHANGE_ME
