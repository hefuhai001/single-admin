# ==================== 基础配置 ====================
# 时区设置
TZ=Asia/Shanghai

# ==================== 端口配置 ====================
# 宿主机端口映射（根据实际需求修改）
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_PORT=9000
FILES_PORT=9001
BACKEND_PORT=8080
FRONTEND_PORT=80

# ==================== 数据库配置 ====================
# MySQL 配置
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=db_single_admin

# Redis 配置
REDIS_PASSWORD=123456

# ==================== MinIO 配置 ====================
# MinIO 管理员账号密码
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ==================== 应用配置 ====================
# Spring Boot 环境（dev/test/prod）
SPRING_PROFILES_ACTIVE=prod

# JVM 参数（可选）
# JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0

# 镜像版本（可选）
# VERSION=1.0.0