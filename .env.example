# ============================================================
# 全项目唯一环境变量模板
#
# 使用方式：复制为项目根目录 .env 并按需填写（.env 已被 .gitignore 忽略，禁止提交）
# 读取方：
#   - docker compose：自动读取根目录 .env，注入各服务与镜像版本
#   - 后端本地开发：Spring 从项目根 .env 导入（dev/test profile）
#   - 前端本地开发：Vite 的 envDir 指向项目根，读取 VITE_* 变量
#   - 前端 Docker 构建：compose 通过 build args 注入 VITE_API_URL，不把 .env 拷进镜像
# ============================================================

# ===== 基础与端口（docker compose）=====
TZ=Asia/Shanghai
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_PORT=9000
FILES_PORT=9001
BACKEND_PORT=8080
FRONTEND_PORT=80

# ===== 数据库与中间件凭据（docker compose + 容器内后端）=====
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=db_single_admin
# 应用专用账号，仅拥有业务库权限，不要使用 root
MYSQL_USER=single_admin
MYSQL_PASSWORD=change_me_single_admin
REDIS_PASSWORD=change_me_redis
MINIO_ROOT_USER=change_me_minio
MINIO_ROOT_PASSWORD=change_me_minio

# ===== 应用（docker compose）=====
# 仅由 compose 注入容器；本地后端启动请用环境变量显式指定 dev（见 README）
SPRING_PROFILES_ACTIVE=prod
# JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0
# VERSION=1.0.0

# ===== 本地后端开发（dev/test profile）=====
# 本地直连宿主机中间件；容器内部由 compose 显式注入 MYSQL_HOST / REDIS_HOST，不受这些值影响
MYSQL_HOST=localhost
REDIS_HOST=127.0.0.1
REDIS_DATABASE=0
# 本地 MySQL 若使用与 compose 不同的账号，在此单独配置；
# 不配置时回退到 MYSQL_USER / MYSQL_PASSWORD
LOCAL_MYSQL_USER=root
LOCAL_MYSQL_PASSWORD=change_me_local

# ===== 前端（Vite，本地 dev/test/prod 与 Docker 构建共用）=====
# 所有环境统一走 nginx 的 /api 反向代理
VITE_API_URL=/api
# 可选：覆盖默认代理目标。不配置时按 vite.config.js 中的 mode 映射
# （development 本地后端 / test 测试环境 / production 线上地址）
# VITE_API_PROXY=http://127.0.0.1:9999
# VITE_WS_PROXY=ws://127.0.0.1:9999
# VITE_ACTUATOR_PROXY=http://127.0.0.1:9999
